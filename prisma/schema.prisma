// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Null for OAuth-only accounts (e.g. Google).
  password  String?
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      Project[]
  savedProjects SavedProject[]
}

model Project {
  id          String   @id @default(cuid())
  title       String   @default("Untitled Carousel")
  aspectRatio String   @default("4:5")
  width       Int      @default(1080)
  height      Int      @default(1350)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slides  Slide[]
  savedBy SavedProject[]

  @@index([userId])
  @@index([userId, updatedAt])
}

/// One Fabric canvas snapshot in a carousel project.
/// Client uses ephemeral numeric ids; persistence key is `id` + `order`.
model Slide {
  id         String  @id @default(cuid())
  order      Int
  canvasJSON Json
  thumbnail  String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model Template {
  id          String   @id @default(cuid())
  title       String
  category    String
  badge       String?
  previewUrl  String?
  aspectRatio String   @default("4:5")
  canvasJSON  Json
  createdAt   DateTime @default(now())

  @@index([category])
}

/// Bookmarks / "saved" projects for a user (not ownership).
model SavedProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}
